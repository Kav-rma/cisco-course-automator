  "html": "<tabs-view modelid=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c\" class=\"is-full zoom-graphic-enabled\" sgpulse-type=\"component\"><template shadowroot=\"open\"><div class=\"component\"><div class=\"tab-inner component__inner\"><div data-socialgoodpulse-id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c\" class=\"component tabs 982c8e0ca47b4f02a8f9c38b4d0ffd5c  is-full is-complete  \"><div class=\"component__header-container\"><div data-socialgoodpulse-id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c\" class=\"tab \"><base-view type=\"component\" lowercase_component=\"tabs\" customclass=\"\"><template shadowroot=\"open\"><div class=\"component__header-wrapper  \"><div class=\"component__header tabs__header\"><div class=\"component__header-inner tabs__header-inner\"><div class=\"component__content\"><div tabindex=\"0\" class=\"component__body tabs__body\"><div class=\"component__body-inner tabs__body-inner\"><p>Imagine how difficult communication would be if the only way to send a message to someone was to use the person's name. If there were no street addresses, cities, towns, or country boundaries, delivering a message to a specific person across the world would be nearly impossible.</p><p><strong>Click each button below for an example of a hierarchical way to pinpoint a location.</strong></p></div></div></div></div></div></div></template></base-view></div></div><div class=\"component__widget tab__widget\"><div class=\"tabs__nav\"><div class=\"tabs__nav-inner\" role=\"tablist\"><button tabindex=\"0\" role=\"tab\" data-index=\"0\" aria-selected=\"true\" aria-controls=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-0-tabpanel\" aria-label=\"North America\" class=\"tabs__nav-item-btn js-tabs-nav-item-btn-click is-visited isSelected\"><div class=\"tabs__nav-item-btn-inner\" id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-0-tabtitle\">North America</div></button><button tabindex=\"0\" role=\"tab\" data-index=\"1\" aria-selected=\"false\" aria-controls=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-1-tabpanel\" aria-label=\"Canada\" class=\"tabs__nav-item-btn js-tabs-nav-item-btn-click is-visited \"><div class=\"tabs__nav-item-btn-inner\" id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-1-tabtitle\">Canada</div></button><button tabindex=\"0\" role=\"tab\" data-index=\"2\" aria-selected=\"false\" aria-controls=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-2-tabpanel\" aria-label=\"Nova Scotia\" class=\"tabs__nav-item-btn js-tabs-nav-item-btn-click is-visited \"><div class=\"tabs__nav-item-btn-inner\" id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-2-tabtitle\">Nova Scotia</div></button><button tabindex=\"0\" role=\"tab\" data-index=\"3\" aria-selected=\"false\" aria-controls=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-3-tabpanel\" aria-label=\"Halifax\" class=\"tabs__nav-item-btn js-tabs-nav-item-btn-click is-visited \"><div class=\"tabs__nav-item-btn-inner\" id=\"982c8e0ca47b4f02a8f9c38b4d0ffd5c-3-tabtitle\">Halifax</div></button></div></div><div class=\"tabs__widget component__widget clearfix\" tabindex=\"0\"><div class=\"tabs__content\"><div class=\"tabs__content-inner delayed-transform\"><div role=\"tabpanel\" id=\"0-tabpanel\" aria-labelledby=\"0-tabtitle\" data-index=\"item-0\" class=\"tabs__content-item item-0\"><div class=\"tabs__content-item-inner \"><div class=\"tabs__content-item-title\"><div class=\"tabs__content-item-title-inner\"><strong tabindex=\"\"></strong></div></div><div class=\"tabs__content-item-body\"><div class=\"tabs__content-item-body-inner\"><p tabindex=\"0\"></p></div></div><div class=\"tabs__content-item-graphic\"></div><div class=\"tabs-item-image-container\"><component-selector><template shadowroot=\"open\"><dynamic-graphic-view modelid=\"8c1b4fc0-e625-11ea-bddd-5127370b77b7\" sgpulse-type=\"component\" fadeoutoverlay=\"\"><template shadowroot=\"open\"><link rel=\"stylesheet\" href=\"_assets/media/8c1b4fc0-e625-11ea-bddd-5127370b77b7/24e0fbd5-331e-406d-b085-72392a126a5a.css\"></link><div data-socialgoodpulse-id=\"8c1b4fc0-e625-11ea-bddd-5127370b77b7\" class=\"component dynamic-graphic 8c1b4fc0-e625-11ea-bddd-5127370b77b7 undefined is-undefined   \"><div class=\"component__header-container\"><base-view type=\"component\" lowercase_component=\"dynamic-graphic\" customclass=\"\"><template shadowroot=\"open\"><div class=\"component__header-wrapper undefined \"><div class=\"component__header dynamic-graphic__header\"><div class=\"component__header-inner dynamic-graphic__header-inner\"></div></div></div></template></base-view></div><div class=\"component__widget\"><div class=\"a11y_description screen-reader-hide\" aria-live=\"polite\" id=\"a11y_description-8c1b4fc0-e625-11ea-bddd-5127370b77b7\">The figure shows a map of North America from top to bottom are Greenland, Canada, United States of America, and Mexico.</div><div tabindex=\"0\" role=\"figure\" id=\"8c1b4fc0-e625-11ea-bddd-5127370b77b7\" class=\"dynamic-graphic-container 8c1b4fc0-e625-11ea-bddd-5127370b77b7\" aria-labelledby=\"a11y_description-8c1b4fc0-e625-11ea-bddd-5127370b77b7\"><div class=\"dynamic-graphic-display\"><div role=\"presentation\" aria-hidden=\"true\" class=\"overlay removed\"></div><div class=\"dynamic-graphic-content\"><div class=\"primary-image-wrapper\"><inline-svg-viewer src=\"./_assets/media/8c1b4fc0-e625-11ea-bddd-5127370b77b7/2784abc0-5193-42f5-b69c-86d509c0f62a.svg\" stylesheet=\"media/8c1b4fc0-e625-11ea-bddd-5127370b77b7/24e0fbd5-331e-406d-b085-72392a126a5a.css\"><template shadowroot=\"open\"><link rel=\"stylesheet\" href=\"_assets/media/8c1b4fc0-e625-11ea-bddd-5127370b77b7/24e0fbd5-331e-406d-b085-72392a126a5a.css\"></link><div></div></template></inline-svg-viewer></div><div class=\"dynamic-text\"><div id=\"text1\" class=\"dynamic-text-item text1\">Greenland</div><div id=\"text2\" class=\"dynamic-text-item text2\">Canada</div><div id=\"text3\" class=\"dynamic-text-item text3\">United States of America</div><div id=\"text4\" class=\"dynamic-text-item text4\">Mexico</div></div><div class=\"below-primary-image\"><img id=\"north-america-map--UUID\" class=\"north-america-map--UUID dynamic-image-item\" src=\"_assets/media/8c1b4fc0-e625-11ea-bddd-5127370b77b7/02572ff0-f2a7-11ea-86ec-01dcf970d4ae.png\"></img></div></div></div></div></div></div></template></dynamic-graphic-view></template></component-selector></div></div></div></div></div></div></div></div></div></div></template></tabs-view>",
