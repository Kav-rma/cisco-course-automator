  "html": "<text-view modelid=\"63abc869231f0402b0232a08\" class=\"is-left remove-padding-top\" sgpulse-type=\"component\"><template shadowroot=\"open\"><div class=\"text-inner component__inner\"><div class=\"component__header-container\"><div data-socialgoodpulse-id=\"63abc869231f0402b0232a08\" class=\"component text 63abc869231f0402b0232a08 remove-padding-top is-left is-complete  animated pulse infinite\"><base-view type=\"component\" lowercase_component=\"text\" customclass=\"\"><template shadowroot=\"open\"><div class=\"component__header-wrapper remove-padding-top \"><div class=\"component__header text__header\"><div class=\"component__header-inner text__header-inner\"><div class=\"component__content\"><div tabindex=\"0\" class=\"component__body text__body\"><div class=\"component__body-inner text__body-inner\"><p>Scroll to begin<i class=\"fa fa-arrow-circle-down\"></i></p></div></div></div></div></div></div></template></base-view></div></div></div></template></text-view>",
